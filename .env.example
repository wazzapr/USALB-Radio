# Replit PostgreSQL
DATABASE_URL=

# Required for signed admin cookies
SESSION_SECRET=

# Admin bootstrap. Set ADMIN_PASSWORD_HASH to a scrypt hash before first start.
# The API never accepts or stores a plaintext admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Broadcaster pairing and publish authentication
BROADCASTER_PAIRING_CODE=

# Optional override when the public deployment uses a custom canonical URL.
PUBLIC_RADIO_STREAM_URL=/api/radio-stream

# Optional metadata used by diagnostics and legacy heartbeat clients.
STREAM_SERVER_URL=
STREAM_MOUNT=/api/radio-ingest