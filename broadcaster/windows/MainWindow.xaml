<Window x:Class="USALB.Broadcaster.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="USALB Broadcaster · Control Room" Width="900" Height="720"
 WindowStartupLocation="CenterScreen" Background="#0B0E13" Foreground="White">
<Grid Margin="26">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel>
 <TextBlock Text="USALB RADIO" FontSize="30" FontWeight="Bold"/>
 <TextBlock Text="BROADCASTER · CONTROL ROOM" FontSize="12" FontWeight="SemiBold" Foreground="#8E96A5" Margin="0,2,0,18"/>
</StackPanel>
<Grid Grid.Row="1">
<Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,18,0">
 <Border Background="#151922" CornerRadius="16" Padding="18" Margin="0,0,0,14">
  <StackPanel>
   <TextBlock Text="BROADCAST" FontSize="12" FontWeight="Bold" Foreground="#8E96A5"/>
   <TextBlock x:Name="LiveStateText" Text="OFFLINE" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
   <Button x:Name="LiveButton" Content="GO LIVE" Height="58" Margin="0,16,0,0" FontSize="18" FontWeight="Bold" Click="LiveButton_Click"/>
   <TextBlock x:Name="StatusText" Text="Ready — opening this app does not stream." Margin="0,12,0,0" Foreground="#AEB4C0" TextWrapping="Wrap"/>
  </StackPanel>
 </Border>
 <Border Background="#151922" CornerRadius="16" Padding="18" Margin="0,0,0,14">
  <StackPanel>
   <TextBlock Text="AUDIO INPUTS" FontSize="12" FontWeight="Bold" Foreground="#8E96A5"/>
   <CheckBox x:Name="SystemAudioBox" Content="Windows system audio (loopback)" IsChecked="True" Margin="0,12,0,0"/>
   <CheckBox x:Name="MicBox" Content="Microphone" Margin="0,10,0,0"/>
   <Grid Margin="0,14,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
    <TextBlock Text="Music volume" VerticalAlignment="Center"/>
    <Slider x:Name="MusicVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="100"/>
   </Grid>
   <Grid Margin="0,10,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
    <TextBlock Text="Mic volume" VerticalAlignment="Center"/>
    <Slider x:Name="MicVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="100"/>
   </Grid>
  </StackPanel>
 </Border>
 <Border Background="#151922" CornerRadius="16" Padding="18">
  <StackPanel>
   <TextBlock Text="CONNECTION" FontSize="12" FontWeight="Bold" Foreground="#8E96A5"/>
   <TextBlock Text="USALB server" Margin="0,10,0,0"/>
   <TextBox x:Name="ServerBox" Text="https://usalb-radio--applauncher.replit.app" Margin="0,5,0,0" Padding="9" Background="#0D1016" Foreground="White" BorderBrush="#303541"/>
   <TextBlock Text="Broadcaster key" FontSize="11" Foreground="#8E96A5" Margin="0,10,0,0"/>
   <PasswordBox x:Name="KeyBox" Margin="0,5,0,0" Padding="9" Background="#0D1016" Foreground="White" BorderBrush="#303541"/>
  </StackPanel>
 </Border>
</StackPanel>
<StackPanel Grid.Column="1">
 <Border Background="#151922" CornerRadius="16" Padding="18" Margin="0,0,0,14">
  <StackPanel>
   <TextBlock Text="LIVE MONITOR" FontSize="12" FontWeight="Bold" Foreground="#8E96A5"/>
   <TextBlock Text="Listeners" FontSize="12" Foreground="#8E96A5" Margin="0,14,0,0"/>
   <TextBlock x:Name="ListenerCountText" Text="0" FontSize="32" FontWeight="Bold"/>
   <TextBlock Text="Stream" FontSize="12" Foreground="#8E96A5" Margin="0,14,0,0"/>
   <TextBlock x:Name="ConnectionText" Text="OFFLINE" FontWeight="SemiBold"/>
   <TextBlock Text="Bitrate" FontSize="12" Foreground="#8E96A5" Margin="0,14,0,0"/>
   <TextBlock x:Name="BitrateText" Text="—"/>
   <TextBlock Text="Sample rate" FontSize="12" Foreground="#8E96A5" Margin="0,10,0,0"/>
   <TextBlock x:Name="SampleRateText" Text="—"/>
  </StackPanel>
 </Border>
 <Border Background="#151922" CornerRadius="16" Padding="18" Margin="0,0,0,14">
  <StackPanel>
   <TextBlock Text="NOW PLAYING" FontSize="12" FontWeight="Bold" Foreground="#8E96A5"/>
   <TextBlock x:Name="ArtistText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
   <TextBlock x:Name="TitleText" Text="—" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
  </StackPanel>
 </Border>
 <Border Background="#151922" CornerRadius="16" Padding="18">
  <StackPanel>
   <TextBlock Text="STATION" FontSize="12" FontWeight="Bold" Foreground="#8E96A5"/>
   <TextBlock x:Name="StationText" Text="USALB Radio" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
   <TextBlock Text="44.1 kHz · Stereo · server-side MP3" Foreground="#AEB4C0" Margin="0,4,0,0"/>
   <TextBlock Text="One broadcaster connection · no browser capture" Foreground="#AEB4C0" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Border>
</StackPanel>
</Grid>
<TextBlock Grid.Row="2" x:Name="FooterText" Text="Control Room ready" Foreground="#6F7785" Margin="0,14,0,0"/>
</Grid>
</Window>