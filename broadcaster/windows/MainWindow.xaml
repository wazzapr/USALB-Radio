<Window x:Class="USALB.Broadcaster.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="USALB Broadcaster" Width="620" Height="500" WindowStartupLocation="CenterScreen" Background="#111318" Foreground="White">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="USALB BROADCASTER" FontSize="28" FontWeight="Bold"/>
<TextBlock Grid.Row="1" Margin="0,8,0,20" Text="Professional PC audio bridge · 44.1 kHz stereo · server-side encoding" Foreground="#AEB4C0"/>
<StackPanel Grid.Row="2"><Border Background="#1B1E25" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel>
<TextBlock Text="SERVER" FontSize="11" FontWeight="Bold" Foreground="#8E96A5"/>
<TextBox x:Name="ServerBox" Text="https://usalb-radio--applauncher.replit.app" Margin="0,7,0,0" Padding="10" Background="#0D0F13" Foreground="White" BorderBrush="#303541"/>
<TextBlock Text="Stream key (optional)" FontSize="11" Foreground="#8E96A5" Margin="0,12,0,0"/>
<PasswordBox x:Name="KeyBox" Margin="0,7,0,0" Padding="10" Background="#0D0F13" Foreground="White" BorderBrush="#303541"/>
</StackPanel></Border>
<Border Background="#1B1E25" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="AUDIO INPUTS" FontSize="11" FontWeight="Bold" Foreground="#8E96A5"/>
<CheckBox x:Name="SystemAudioBox" Content="Windows system audio (loopback)" IsChecked="True" Margin="0,10,0,0"/>
<CheckBox x:Name="MicBox" Content="Microphone" Margin="0,10,0,0"/>
<TextBlock x:Name="StatusText" Text="Ready" Margin="0,18,0,0" Foreground="#8E96A5"/></StackPanel></Border></StackPanel>
<Button x:Name="LiveButton" Grid.Row="3" Content="GO LIVE" Height="58" Margin="0,20,0,0" FontSize="18" FontWeight="Bold" Click="LiveButton_Click"/>
</Grid></Window>
